// WireGuardTray.rc
//
// BMP paths are passed by the RC compiler via /D macros from the vcxproj:
//   WGCP_BMP_CONN = full path to wireguard_connected.bmp
//   WGCP_BMP_DISC = full path to wireguard_disconnected.bmp
// This avoids any relative-path ambiguity (RC compiler working dir issues).

#include <windows.h>
#include "resource.h"

// App-Icon (ID 1 = Windows Standard fuer Explorer, Taskleiste, Autostart)
1 ICON "icon.ico"

// CP-Icons (fuer Kompatibilitaet beibehalten)
IDB_WIREGUARD_CONNECTED    BITMAP  WGCP_BMP_CONN
IDB_WIREGUARD_DISCONNECTED BITMAP  WGCP_BMP_DISC

// Tray-Icons als ICO (unterstuetzt Alpha-Kanal und mehrere Groessen)
#define IDI_TRAY_CONNECTED    103
#define IDI_TRAY_DISCONNECTED 104
IDI_TRAY_CONNECTED    ICON  "wireguard_tray_connected.ico"
IDI_TRAY_DISCONNECTED ICON  "wireguard_tray_disconnected.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2026,7,31,0
PRODUCTVERSION  2026,7,31,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Jens Kaesler"
            VALUE "FileDescription",  "WireGuard Credential Provider - Tray Application"
            VALUE "FileVersion",      "2026.7.31"
            VALUE "InternalName",     "WireGuardCPTray"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "WireGuardCPTray.exe"
            VALUE "ProductName",      "WireGuard Credential Provider"
            VALUE "ProductVersion",   "2026.7.31"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
